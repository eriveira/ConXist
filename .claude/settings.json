{
  "extraKnownMarketplaces": {
    "wdteams": {
      "source": {
        "source": "github",
        "repo": "eriveira/engineering-standards"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "engineering-standards@wdteams": true,
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
